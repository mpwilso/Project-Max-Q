    {"family": "sales role", "patterns": ["\\baccount executives?\\b", "\\bsales executives?\\b", "\\bsales representatives?\\b", "\\bsales development (?:reps?|representatives?|managers?|leads?|directors?)\\b", "\\bbusiness development representatives?\\b", "^(?:senior |sr\\.? |lead |principal )?(?:sdr|bdr)s?\\b", "\\bsales engineers?\\b", "\\bsales managers?\\b", "\\bdirector of sales\\b", "\\bsales directors?\\b"], "except": []},
